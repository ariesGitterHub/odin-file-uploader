  DOCUMENT    @map("📄")
  IMAGE1      @map("📸")
  IMAGE2      @map("🖼")
  AUDIO1      @map("📻")
  AUDIO2      @map("🎧")
  VIDEO1      @map("📹")
  VIDEO2      @map("🎬")
  VIDEO3      @map("🎞")
  ARCHIVE1    @map("🗄")
  ARCHIVE2    @map("🗃")
  TRASH       @map("🗑")
  FOLDER1     @map("📁")
  FOLDER2     @map("📂")
  ART         @map("🎨️")
  BACKUP      @map("💾")
  BOOK        @map("📚")
  DRAFT       @map("✍️")
  EVENT       @map("🎂")
  FAMILY      @map("👪")
  FAVORITE    @map("⭐")
  FINANCE     @map("💰")
  FITNESS     @map("🏃")
  IDEA        @map("💡")
  LEARNING    @map("🧠")
  LIST        @map("📋")
  PERSONAL    @map("🤍")
  PROGRAMMING @map("💻")
  PROJECT     @map("🚧")
  PUZZLE      @map("🧩")
  RECEIPT     @map("🧾")
  RECIPE      @map("🍲")
  SCHOOL      @map("🎓")
  SWORD       @map("🗡")
  VACATION    @map("🏖️")
  WORK        @map("💼")
}

