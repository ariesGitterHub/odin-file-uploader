// This is my Prisma schema file, learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output = "..app/generated/client" // Most teams do not commit generated Prisma clients, and use .gitignore to add "generated/prisma", NOTE - the traditional setup doesn't even use output
}

datasource db {
  provider = "postgresql"
  // NOTE - below VS Code message: Your Prisma schema file is missing the datasource URL and the current workspace is pinned to Prisma 6. The datasource URL is required in Prisma 6, but no longer expected in Prisma 7. If you intend to use Prisma 7, press the button below to unpin the current workspace from Prisma 6. If you want to continue using Prisma 6, you can ignore this message.
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FolderEmoji {
  GENERAL     @map("📁")
  DOCUMENT    @map("📄")
  IMAGE       @map("📸")
  AUDIO       @map("🎧")
  VIDEO       @map("🎬")
  ARCHIVE     @map("🗃️")
  TRASH       @map("🗑️")
  ART         @map("🎨️")
  BACKUP      @map("💾")
  BOOK        @map("📚")
  DRAFT       @map("✍️")
  EVENT       @map("🎂")
  FAMILY      @map("👪")
  FAVORITE    @map("⭐")
  FINANCE     @map("💰")
  FITNESS     @map("🏃")
  GAMING      @map("🕹️")
  HUMOR       @map("😂")
  IDEA        @map("💡")
  LEARNING    @map("🧠")
  LIST        @map("📋")
  PERSONAL    @map("♥️")
  PROGRAMMING @map("💻")
  PROJECT     @map("🚧")
  PUZZLE      @map("🧩")
  RECEIPT     @map("🧾")
  RECIPE      @map("🍲")
  RPG         @map("🗡️")
  SCHOOL      @map("🎓")
  VACATION    @map("⛱️️")
  WORK        @map("💼")
}

model Session {
  id        String   @id
  sid       String   @unique // the Express session ID stored in the user's cookie.
  data      String   @db.Text // the serialized session data (Passport user ID, cookie information, CSRF data, etc.).
  expiresAt DateTime

  @@index([expiresAt]) // makes cleanup of expired sessions efficient.
  @@map("sessions")
}

model User {
  id String @id @default(uuid())

  firstName String @map("first_name")
  lastName  String @map("last_name")

  email        String @unique
  passwordHash String @map("password_hash")

  role UserRole @default(USER)

  storageUsedBytes BigInt @default(0) @map("storage_used_bytes")

  emailVerified Boolean @default(false) @map("email_verified")
  // emailVerified DateTime? @map("email_verified") // NOTE: many production apps use a timestamp here, but using a Boolean supports my use now

  lastLoginAt DateTime? @map("last_login_at") // NOTE: ? means nullable fields

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // User Foreign Keys are used in these tables as Relations
  folders    Folder[]
  files      File[]
  shareLinks ShareLink[]

  @@map("users") // NOTE: this lets me use singular Prisma model names AND use plural SQL table names; it is a common practice
}

model Folder {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // user this folder belongs to

  parentFolderId String? @map("parent_folder_id")
  parentFolder   Folder? @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)

  childFolders Folder[] @relation("FolderHierarchy") // NOTE: "FolderHierarchy" string is just Prisma metadata that helps the ORM understand the self-referencing relationship

  folderName        String      @map("folder_name") @db.VarChar(100)
  folderImage       FolderEmoji @default(GENERAL) @map("folder_image")
  // color String?
  folderDescription String?     @map("folder_description") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Folder Foreign Keys are used in these tables as Relations
  files      File[]
  shareLinks ShareLink[]

  @@unique([userId, parentFolderId, folderName])
  @@index([userId])
  @@index([parentFolderId])
  @@map("folders")
}

model File {
  id String @id @default(uuid())

  folderId String @map("folder_id") // NOTE - requires every file to belong to a folder
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade) // folder this file belongs in

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // user who uploaded this file

  originalFileName String @map("original_file_name") @db.VarChar(255) // NOTE - what the original file is named

  mimeType  String @map("mime_type") // Use enum for this??? NO! ❌
  sizeBytes BigInt @map("size_bytes")

  cloudKey      String @map("cloud_key") // storage provider key
  cloudProvider String @map("cloud_provider") // TODO - create an ENUM for this later? `S3`, `CLOUDFLARE_R2`, etc

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // File Foreign Keys are used in these tables as Relations
  shareLinks ShareLink[]

  @@map("files")
}

model ShareLink {
  id String @id @default(uuid())

  token String @unique // TODO & NOTE - Just remember Prisma won't automatically generate it. I'll need something like: crypto.randomUUID()

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // user who owns this folder/file

  folderId String? @map("folder_id")
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade) // folder this file belongs in

  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade) // folder this file belongs in

  passwordHash String? @map("password_hash") // TODO - is this needed? Likely not, but keep in case I change my mind later.

  maxDownloads Int? @map("max_downloads")
  downloadCount Int @default(0) @map("download_count") // NEW 8/4/2026

  isActive Boolean @default(true) @map("is_active")

  expiresAt DateTime? @map("expires_at") // NOTE - use of Nullable ?, as links might never expire!
  lastAccessedAt DateTime? @map("last_accessed_at")// NEW 8/4/2026
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // folderId IS NOT NULL AND fileId IS NULL OR folderId IS NULL AND fileId IS NOT NULL // TODO - what is the proper syntax for this? TODO - ad this to app code or elsewhere later

  @@index([token]) // TODO - keep?
  @@map("share_links")
}

