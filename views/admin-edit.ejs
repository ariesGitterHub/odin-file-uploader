<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default frame-border-white">
        <h2 class="subtitle">Edit User <%= userProfile.firstName %> <%= userProfile.lastName %> </h2>
       <form class="element-container-col-start-center form-width" action="/app/admin-edit/<%= userProfile.id %>" method="POST">
        <%# CSRF Token - hidden input for forms %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="first-name-admin-edit">first name</label>
        <input
          id="first-name-admin-edit"
          type="text"          
          name="first_name"
          value="<%= formData?.first_name || '' %>"
        />
        <label for="last-name-admin-edit">last name</label>
        <input
          id="last-name-admin-edit"
          type="text"          
          name="last_name"
          value="<%= formData?.last_name || '' %>"
        />
        <div class="element-container-row-start-center">
          <label for="email-admin-edit">email</label>
          <% if (errors && errors.some(e => e.field === 'email')) { %>
            <% errors.filter(e => e.field === 'email').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
        </div>
        <input
          id="email-admin-edit"
          type="email"            
          name="email"
          value="<%= formData?.email || '' %>"
        />

        <label for="email-verified-admin-edit">email verified</label>

        <select
          id="email-verified-admin-edit"       
          name="email_verified"
          >
          <option value="false" <%= String(formData?.email_verified) === "false" ? "selected" : "" %>>🔴 False</option>
          <option value="true" <%= String(formData?.email_verified) === "true" ? "selected" : "" %>>🟢 True</option>
        </select>

        <div class="element-container-row-start-center">
          <label for="password-admin-edit">password</label>
          <% if (errors && errors.some(e => e.field === 'password')) { %>
            <% errors.filter(e => e.field === 'password').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
        </div>
        <input
          id="password-admin-edit"
          type="password"
          name="password"
          placeholder="leave blank to keep existing password"
        />
        <div class="element-container-row-start-center">
          <label for="confirm-password-admin-edit">confirm password</label> 
          <% if (errors && errors.some(e => e.field === 'confirm_password')) { %>
            <% errors.filter(e => e.field === 'confirm_password').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
        </div>
        <input
          id="confirm-password-admin-edit"
          type="password"
          name="confirm_password"
          placeholder="re-enter, if new password"
        />
        <%- include("./partials/password-rules.ejs") %>
      
        <div class="button-container-row-space-evenly margin-top">
          <!-- <form action="/app/delete-your-account" method="POST">
            <button class="button-default" type="submit">delete</button>
          </form> -->
          <a class="button-default" href="/app/admin">cancel</a>
          <button class="button-default" type="submit">update</button>
        </div>
      </form>
    </main>
    <%#- include('./partials/footer.ejs') %>
  </body>
</html>
