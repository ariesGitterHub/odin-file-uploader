<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-default">
    <main class="no-background-card element-container-col-start-center flex-gap frame-border margin-left-right">
      <div class="error-subtitle">
        <h1><%= title %></h1>  
      </div>
      <div class="element-container-row-center-start flex-wrap">
        <p class="font-text"><%= error %></p>
        <%# Errors encountered while authenticated in the application %>
        <% if ([400, 404, 409, 413, 422, 429].includes(status)) { %>
          <div class="button-container-row-space-evenly">
            <a class="button-default fit-content-button" href="/app/user-data">back to root</a>
          </div>
        <% } %>
        <%# Authentication required %>
        <% if (status === 401) { %>
          <div class="button-container-row-space-evenly">
            <a class="button-default fit-content-button" href="/app/log-in">login</a>
          </div>
        <% } %>
        <%# Authenticated but not authorized %>
        <% if (status === 403) { %>      
          <div class="button-container-row-space-evenly">
              <a class="button-default fit-content-button" href="/app">back to home</a>
          </div>
        <% } %>
        <%# Unexpected server error %>
        <% if (status === 500) { %>
          <div class="button-container-row-space-evenly">
            <a class="button-default fit-content-button" href="/app">back to home</a>
          </div>
        <% } %>
        <%# Fallback for other status codes (if any, e.g., 429, 502, etc.) %>
        <% if (![400, 401, 403, 404, 409, 413, 422, 429, 500].includes(status)) { %>
          <div class="button-container-row-space-evenly">
            <a class="button-default fit-content-button" href="/app">back to home</a>
          </div>
        <% } %>
      </div>
    </main> 
  </body>
</html>