<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-default">
    <main class="no-background-card element-container-col-default flex-gap frame-border">
      <div class="app-subtitle font-uppercase">
        <h1><%= title %></h1>  
      </div>
      <p class="font-text"><%= error %></p>
      <%# Specific Content for 401 - Unauthorized %>
      <% if (status === 401) { %>
        <div class="button-container-row-space-evenly">
          <a class="button-default fit-content-button" href="/app/login">login</a>
        </div>
      <% } %>
      <%# Specific Content for 403 - Forbidden %>
      <% if (status === 403) { %>      
        <div class="button-container-row-space-evenly">
            <a class="button-default fit-content-button" href="/app">back to home</a>
        </div>
      <% } %>
      <%# Specific Content for 404 - Not Found %>
      <% if (status === 404) { %>
        <div class="button-container-row-space-evenly">
          <a class="button-default fit-content-button" href="/app">back to home</a>
        </div>
      <% } %>
      <%# Specific Content for 500 - Internal Server Error %>
      <% if (status === 500) { %>
        <div class="button-container-row-space-evenly">
          <a class="button-default fit-content-button" href="/app">back to home</a>
        </div>
      <% } %>
      <%# Fallback for other status codes (if any, e.g., 429, 502, etc.) %>
      <% if (![401, 403, 404, 500].includes(status)) { %>
        <div class="button-container-row-space-evenly">
          <a class="button-default fit-content-button" href="/app">back to home</a>
        </div>
      <% } %>
    </main> 
  </body>
</html>