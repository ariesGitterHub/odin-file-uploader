<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default frame-border-white">
      <!-- <div class="subtitle"> -->
        <h2 class="subtitle">Upload a New File</h2>
      <!-- </div> -->
       <form class="element-container-col-start-center form-width" action="/app/new-file" method="POST" enctype="multipart/form-data">
        <%# CSRF Token - hidden input for forms %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="file-name-new-file">file name</label>
        <input
          id="file-name-new-file"
          type="text"          
          name="file"
          value="<%= formData?.file_name || '' %>"
          placeholder="enter new file name"
          required
        />
        <!-- TODO - scratch using this here, use only on new file...-->
        <label for="file-parent-new-file">choose parent folder</label>
          <input
            id="folder-parent-id-new-file"
            type="text"          
            name="parent_folder_id"
            value="<%#= formData?.parent_folder_id || '' %>"
            placeholder="NEEDS TO BE DROPDOWN"
            required
          />
        <!-- <label class="capitalize" for="folder-description-new-folder">
          folder description
        </label> -->
          <!-- <textarea id="folder-description-new-folder" name="folder_description"></textarea> -->
        <div class="button-container-row-space-evenly margin-top">
          <a class="button-default" href="/app/user-data">cancel</a>
          <button class="button-default" type="submit">submit</button>
        </div>
      </form>
    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>
