<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default frame-border">
      <!-- <h2 class="subtitle">Upload a New File</h2> -->
      <h2 class="page-subtitle">Upload a New File</h2>
      <form class="element-container-col-start-center form-width" action="/app/new-file" method="POST" enctype="multipart/form-data">
      <%# CSRF Token - hidden input for forms %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- <label for="card-text-hover-selector-new-file">file name</label>
        <input
          id="card-text-hover-selector-new-file"
          type="text"          
          name="file"
          value="<%#= formData?.file_name || '' %>"
          placeholder="enter new file name"
          required
        /> -->
        <!-- TODO - use a file input -->
        <label for="file-upload">Choose a file</label>
        <input
          id="file-upload"
          type="file"
          name="file"
          required
        />
        <label for="folder-new-folder">store in folder</label>
        <select
          id="folder-id-new-folder"        
          name="folder_id"
          required
        >
          <option
            value=""
            disabled
            <%= !formData?.folder_id ? "selected" : "" %>>
            select a folder for your file
          </option>
          <% userFolders.forEach((userFolder) => { %> 
          <option value="<%= userFolder.id %>"
          <%= formData?.userFolder === userFolder.id ? "selected" : "" %>>
            <%= userFolder.folderName %>
          </option>
          <% }) %>
        </select>
        <div class="button-container-row-space-evenly margin-top">
          <a class="button-default max-percent-width" href="/app/user-data">cancel</a>
          <button class="button-default max-percent-width" type="submit">upload</button>
        </div>
      </form>
    </main>
    <%#- include('./partials/footer.ejs') %>
  </body>
</html>
