<div class="button-container-row-space-evenly">
  <!-- Edit -->
  <button class="button-default card-button admin-border admin-color">
    <span class="emoji">✏</span>
  </button>
  <!-- Delete -->
  <form action="/app/admin/delete-user/<%= userProfile.id %>" method="POST">
  <%# CSRF Token - hidden input for forms %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="userId" value="<%= userProfile.id %>">
  <button class="button-default card-button admin-border admin-color" type="submit">
    <span class="emoji">❌</span>
  </button> 
  <p><%= userProfile.id %></p> 
  </form>
</div>
