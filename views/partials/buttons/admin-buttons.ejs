<div class="button-container-row-space-evenly">
  <a
    class="button-default admin-button"
    href="/app/admin-edit/<%= userProfile.id %>"
  >
    <span class="emoji">✏</span>
  </a>
  <button
    class="button-default admin-button deletion-form-button"
    data-action="/app/admin/delete-user/<%= userProfile.id %>"
    data-message="Do you wish to delete the account of <%= userProfile.firstName %> <%= userProfile.lastName %> (email: <%= userProfile.email %>)? Reminder: this action cannot be undone."
    type="button"
  >
    <span class="emoji">❌</span>
  </button>
</div>
