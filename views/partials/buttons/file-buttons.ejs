<div class="button-container-row-space-evenly">
  <a class="button-default file-button" href="/app/share-file/<%= file.id %>">
    <span class="emoji">🔗</span>
  </a>
  <form action="/app/download-file/<%= file.id %>">
    <button class="button-default file-button" type="submit">
      <span class="emoji">⬇</span>
    </button>
  </form>
  <% if (file.canPreview) { %>
    <a class="button-default file-button"
      href="/app/preview-file/<%= file.id %>">
      <span class="emoji">👁</span>
    </a>
  <% } %>
  <a class="button-default file-button" href="/app/user-file-edit/<%= file.id %>">
    <span class="emoji">✏</span>
  </a>   
  <button 
    class="button-default file-button deletion-form-button"
    data-action="/app/user-folder/<%= folder.id %>/delete-your-file/<%= file.id %>"
    data-message="Do you wish to delete the file: <%= file.originalFileName %>? Reminder: this action cannot be undone." 
    type="button"
    >
    <span class="emoji">❌</span>
  </button>
</div>
