<div class="button-container-row-space-evenly">
  <!-- Back -->
  <a class="button-default folder-button" href="<%= folder.parentFolderId  ? `/app/user-folder/${folder.parentFolderId}` : '/app/user-data/' %>">
    <span class="emoji">👈</span>
  </a>
  <!-- Share -->    
    <a class="button-default folder-button" href="/app/share-folder/<%= folder.id %>">
      <span class="emoji">🔗</span>
    </a>    
  <!-- Download -->
    <form action="/app/download-folder/<%= folder.id %>">
    <!-- <input type="hidden" name="_csrf" value="<%#= csrfToken %>"> -->
    <button class="button-default folder-button" type="submit">
      <span class="emoji">⬇</span>
    </button>    
  </form>
  <!-- Edit -->
    <a class="button-default folder-button" href="/app/user-folder-edit/<%= folder.id %>">
      <span class="emoji">✏</span>
    </a>    
  <!-- Delete -->
  <!-- <form action="/app/delete-your-folder/<%#= folder.id %>" method="POST"> -->
    <%# CSRF Token - hidden input for forms %>
    <!-- <input type="hidden" name="_csrf" value="<%#= csrfToken %>"> -->
    <button 
      class="button-default folder-button deletion-form-button"
      data-action="/app/delete-your-folder/<%= folder.id %>"
      data-message="Do you wish to delete the folder: <%= folder.folderName %>? Reminder: this action cannot be undone." 
      type="button">
      <span class="emoji">❌</span>
    </button>
  <!-- </form> -->
</div>
