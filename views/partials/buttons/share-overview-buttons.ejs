          <!-- <form class="element-container-col-start-center form-width" action="/app/change-active-status/<%#= shareLink.id %>" method="POST">
            <%# CSRF Token - hidden input for forms %>
            <input type="hidden" name="_csrf" value="<%#= csrfToken %>">
            <input type="hidden" name="is_active" value="<%#= shareLink.isActive %>">
            <button class="button-default max-percent-width" type="submit"><%#= shareLink.isActive ? "🟢 active" : "🔴 inactive" %> </button>
