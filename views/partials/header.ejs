<header class="sticky-header element-container-col-default flex-gap black-border-bottom">
  <%- include('./title.ejs') %>
  <nav class="nav-button-container-row-space-evenly" aria-label="user menu">
    <% if (user && user.role === "ADMIN") { %>
      <a class="button-default nav-button" href="/app/admin">
        <span class="emoji" role="img" aria-label="Admin overview link"> ⚙ </span>
        <span class="icon-and-text"> Admin </span>
      </a>    
    <% } %>
    <a class="button-default nav-button" href="/app/user-data">
      <span class="emoji" role="img" aria-label="User folders link"> 🗄 </span>
      <span class="icon-and-text"> Folders </span>
    </a>
    <a class="button-default nav-button" href="/app/share-overview">
      <span class="emoji" role="img" aria-label="Share overview link"> 🖇 </span>
      <span class="icon-and-text"> Share Overview </span>
    </a>
    <a class="button-default nav-button" href="/app/user-profile">
      <span class="emoji" role="img" aria-label="User profile link"> 👤 </span>
      <span class="icon-and-text"> User Profile </span>
    </a>
    <a class="button-default nav-button" href="/app/new-folder">
      <span class="emoji" role="img" aria-label="New folder link"> +📁 </span>
      <span class="icon-and-text"> New Folder </span>
    </a>
    <a class="button-default nav-button" href="/app/new-file">
      <span class="emoji" role="img" aria-label="Upload file link"> +📄 </span>
      <span class="icon-and-text"> New File </span>
    </a>
    <form action="/app/log-out" method="POST">
      <button class="button-default nav-button" type="submit">
        <span class="emoji emoji-nav-size" role="img" aria-label="Log out"> 📴 </span>
        <span class="icon-and-text"> Logout </span>
      </button>
    </form>
  </nav>
</header>
