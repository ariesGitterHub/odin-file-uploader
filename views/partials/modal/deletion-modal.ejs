<div id="deletion-modal" hidden>
  <div class="modal-content">
    <div class="element-container-row-default">
      <h2 class="app-title font-size-larger">Confirm Deletion</h2>
    </div>
    <p id="deletion-message" class="font-text delete-color"></p>
    <form id="deletion-form" method="POST">
      <%# CSRF Token - hidden input for forms %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="button-container-row-space-evenly">
        <button class="button-default" type="submit">Delete</button>
        <button class="button-default" type="button" id="cancel-deletion">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>
