<div id="deletion-modal" hidden>
    <div class="modal-content">
      <div class="element-container-row-default">
        <h2 class="subtitle">Confirm Deletion</h2>
      </div>
        

        <p id="deletion-message" class="font-normal delete-color"></p>

        <form id="deletion-form" method="POST">
          <%# CSRF Token - hidden input for forms %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <!-- <input type="hidden" name="userId" value="<%#= userProfile.id %>"> -->
          <div class="button-container-row-space-evenly">
            <button class="button-default card-button" type="submit">Delete</button>
            <button class="button-default card-button" type="button" id="cancel-deletion">Cancel</button>              
          </div>
        </form>
    </div>
</div>