<div class="password-rules-container">
  <h3><span class="emoji">🔐</span>Passwords must contain:</h3>
  <p>
    <span class="emoji">↔</span> at least <%= passwordRules.minLength %>
    characters in length
  </p>
  <p>
    <span class="emoji">🔡</span> at least <%= passwordRules.minLowercase %>
    lowercase letter
  </p>
  <p>
    <span class="emoji">🔠</span> at least <%= passwordRules.minUppercase %>
    uppercase letter
  </p>
  <p>
    <span class="emoji">🔢</span> at least <%= passwordRules.minNumbers %>
    number
  </p>
  <p>
    <span class="emoji">🔣</span> at least <%= passwordRules.minSpecialChars %>
    of the following special characters: <%= passwordRules.specialChars %>
  </p>
</div>
