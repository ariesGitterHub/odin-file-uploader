        <div class="button-container-row-space-evenly margin-top">
          <button class="button-default width-default-percent" type="button">delete</button>
          <button class="button-default width-default-percent" type="button"><%= shareLink.isActive ? "🟢 true" : "🔴 false" %> </button>
        </div>
      </form>
      <div class="share-link-card width-default-percent">       
        <% if (shareLink) { %>
          <p class="uppercase font-normal share-color">Your share link is...</p>
          <input class="share-link-input" type="text" value="<%= shareUrl %><%= shareLink.token %>" readonly>
          <div class="button-container-row-space-evenly margin-top">
            <button id="copy-share-link-input" class="button-default width-default-percent" type="button">
              copy share link
            </button>
          </div>          
        <% } %>
      </div>