        <div class="button-container-row-space-evenly margin-top">
          <button class="button-default width-default-percent" type="button"><%= shareLink.isActive ? "🟢 active" : "🔴 inactive" %> </button>

          <button 
            class="button-default width-default-percent deletion-form-button"
            data-action="/app/delete-your-shared-item/<%= shareLink.id %>"
            data-message="Do you wish to delete this shared item: <%= shareLink.folder.folderName ? shareLink.folder.folderName : shareLink.file.originalFileName %>
              <%= shareLink.folder.folderName ? "(folder)" : "(file)" %>? Reminder: this action cannot be undone." 
            type="button">
            delete
          </button>

        </div>
      </form>
      <div class="share-link-card width-default-percent">       
        <% if (shareLink) { %>
          <p class="uppercase font-normal">Your share link is...</p>
          <input class="share-link-input" type="text" value="<%= shareUrl %><%= shareLink.token %>" readonly>
          <div class="button-container-row-space-evenly margin-top">
            <button id="copy-share-link-input" class="button-default width-default-percent" type="button">
              copy share link
            </button>
          </div>          
        <% } %>
      </div>