<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default frame-border-white">
      <h2 class="subtitle">
        Share Existing
        <% if (itemType === "folder") { %>
        Folder
        <% } else { %> 
        File
        <% } %>
      </h2>
      <% if (itemType === "folder") { %>
        <form class="element-container-col-start-center form-width" action="/app/share-folder/<%= folder.id %>" method="POST">
        <% } else { %> 
        <form class="element-container-col-start-center form-width" action="/app/share-file/<%= file.id %>" method="POST">
        <% } %>
        <%# CSRF Token - hidden input for forms %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h3 class="font-normal">
        You are seeking to share the
        <% if (itemType === "folder") { %>
        folder...
        <% } else { %> 
        file...
        <% } %>
      </h3>
      <h4 class="share-backdrop margin-top-bottom"> 
        <% if (itemType === "folder") { %>
          <span class="emoji"><%= folder.emoji %></span> <%= folder.folderName %>
        <% } else { %> 
          <span class="emoji">👉</span> <%= file.originalFileName %>
        <% } %>
        </h4>
        <label for="share-folder-or-file-expires-at">choose share link expiration</label>
          <select
            id="share-folder-or-file-expires-at"     
            name="expires_at"
            required
          >
          <!-- <option
            value=""
            disabled
            <%#= !formData?.folder_id ? "selected" : "" %>>
            select an expiration date
          </option> -->
          <option value="" selected disabled>
            Select an expiration
          </option>
          <option value="never">Never</option>
          <option value="1-day">1 day</option>
          <option value="7-days">7 days</option>
          <option value="30-days">30 days</option>
          <option value="custom">Custom</option>
        </select>

        <div id="custom-expiration" hidden>
          <label for="share-folder-or-file-custom-expires-at">expiration date and time</label>
          <input
            id="share-folder-or-file-custom-expires-at"
            name="custom_expires_at"          
            type="datetime-local"
          >
          <input
            type="hidden"
            id="share-folder-or-file-timezone"
            name="timezone"
          >
        </div>
        <div>
          <label for="share-folder-or-file-max-downloads">maximum downloads allowed</label>
          <input
            id="share-folder-or-file-max-downloads"
            name="max_downloads"          
            type="number"
            min="1"
            step="1"
            placeholder="Leave blank for unlimited"
          >
        </div>
        <!-- TODO - add max download limit! -->
        <div class="button-container-row-space-evenly margin-top">
          <a class="button-default width-default-percent" href="/app/user-data">cancel</a>
          <button class="button-default width-default-percent" type="submit">generate link</button>
        </div>
      </form>
      <div class="share-link-card width-default-percent">       
        <%# if (shareLink) { %>
        <% if (shareLink) { %>
          <br>
          <h4 class="font-normal">Your share link is...</h4>
          <input class="share-link-input" type="text" value="<%= shareUrl %>" readonly>
          <div class="button-container-row-space-evenly margin-top">
            <button id="copy-share-link-input" class="button-default width-default-percent copy-share-link-button" type="button">
              copy share link
            </button>
          </div>          
        <% } %>
      </div>
      <div class="element-container-col-default form-width">
        <h3 class="subtitle">
          <% if (itemType === "folder") { %>
          Folder
          <% } else { %> 
          File
          <% } %>
          Share History
        </h3>
        <% if (itemType === "folder") { %> 
          <% if (shareHistoryByFolder.length === 0) { %>
            <div class="font-normal">
              <h4>There is no history of sharing this folder.</h4>
            </div>
            <% } else { %> 
            <% shareHistoryByFolder.forEach(record => { %>
              <%- include('./partials/share-link-history.ejs', { record }) %>
            <% }) %> 
            <% } %>           
        <% } %>

        <% if (itemType === "file") { %> 
          <% if (shareHistoryByFile.length === 0) { %>
            <div class="font-normal">
              <h4>There is no history of sharing this file.</h4>
            </div>
            <% } else { %> 
            <% shareHistoryByFile.forEach(record => { %>
              <%- include('./partials/share-link-history.ejs', { record }) %>
            <% }) %> 
            <% } %>     
        <% } %>

    </div>
    </main>
    <%#- include('./partials/footer.ejs') %>
    <script src="/js/expiration-select-custom.js" defer></script>
    <script src="/js/copy-share-link.js" defer></script>
  </body>
</html>
