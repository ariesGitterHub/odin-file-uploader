<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default frame-border">
      <!-- <h2 class="subtitle"> -->
      <h2 class="app-subtitle">
        Share Existing
        <% if (itemType === "folder") { %>
        Folder
        <% } else { %> 
        File
        <% } %>
      </h2>
      <% if (itemType === "folder") { %>
        <form class="element-container-col-start-center form-width" action="/app/share-folder/<%= folder.id %>" method="POST">
        <% } else { %> 
        <form class="element-container-col-start-center form-width" action="/app/share-file/<%= file.id %>" method="POST">
        <% } %>
        <%# CSRF Token - hidden input for forms %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h3 class="font-text">
        You are seeking to share the
        <% if (itemType === "folder") { %>
        folder...
        <% } else { %> 
        file...
        <% } %>
      </h3>
      <h4 class="share-backdrop margin-top-bottom"> 
        <% if (itemType === "folder") { %>
          <span class="emoji"><%= folder.emoji %></span> <%= folder.folderName %>
        <% } else { %> 
          <span class="emoji">👉</span> <%= file.originalFileName %>
        <% } %>
        </h4>
        <%- include('./partials/subfolder-no-files.ejs') %>
        <label for="share-folder-or-file-expires-at">choose expiration</label>
        <% if (errors && errors.some(e => e.field === 'expires_at')) { %>
          <% errors.filter(e => e.field === 'expires_at').forEach(e => { %>
            <span class="error-message">[<%= e.message %>]</span>
          <% }) %>
        <% } %>
          <select
            id="share-folder-or-file-expires-at"     
            name="expires_at"
            required
          >
          <!-- <option value="" selected disabled>
            Select an expiration
          </option>
          <option value="never">Never</option>
          <option value="1-day">1 day</option>
          <option value="7-days">7 days</option>
          <option value="30-days">30 days</option>
          <option value="custom">Custom</option> -->
          <option value="" disabled
            <%= !formData.expires_at ? "selected" : "" %>
          >
            Select an expiration
          </option>

          <option value="never"
            <%= formData.expires_at === "never" ? "selected" : "" %>
          >
            Never
          </option>

          <option value="1-day"
            <%= formData.expires_at === "1-day" ? "selected" : "" %>
          >
            1 day
          </option>

          <option value="7-days"
            <%= formData.expires_at === "7-days" ? "selected" : "" %>
          >
            7 days
          </option>

          <option value="30-days"
            <%= formData.expires_at === "30-days" ? "selected" : "" %>
          >
            30 days
          </option>

          <option value="custom"
            <%= formData.expires_at === "custom" ? "selected" : "" %>
          >
            Custom
          </option>
        </select>
        <!-- <div id="custom-expiration" hidden> -->
        <div
            id="custom-expiration"
            <%= formData.expires_at === "custom" ? "" : "hidden" %>
          > 
          <label for="share-folder-or-file-custom-expires-at">expiration date and time</label>
          <div class="note-section-text">
            **Please select a future date and time.
          </div>
          <% if (errors && errors.some(e => e.field === 'expires_at_with_time')) { %>
            <% errors.filter(e => e.field === 'expires_at_with_time').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
          <% if (errors && errors.some(e => e.field === 'no_past_expires_at')) { %>
            <% errors.filter(e => e.field === 'no_past_expires_at').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
          <input
            id="share-folder-or-file-custom-expires-at"
            name="custom_expires_at"          
            type="datetime-local"
            value="<%= formData.custom_expires_at || "" %>"
          >
          <input
            type="hidden"
            id="share-folder-or-file-timezone"
            name="timezone"
          >
        </div>
        <div>
          <label for="share-folder-or-file-max-downloads">maximum downloads allowed</label>
            <% if (errors && errors.some(e => e.field === 'max_downloads')) { %>
            <% errors.filter(e => e.field === 'max_downloads').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
          <!-- <input
            id="share-folder-or-file-max-downloads"
            name="max_downloads"          
            type="number"
            min="1"
            step="1"
            placeholder="Leave blank for unlimited"
          > -->
          <input
            id="share-folder-or-file-max-downloads"
            name="max_downloads"
            type="number"
            min="1"
            step="1"
            placeholder="Leave blank for unlimited"
            value="<%= formData.max_downloads || "" %>"
          >
        </div>
        <div class="button-container-row-space-evenly margin-top">
          <a class="button-default max-percent-width" href="/app/user-data">cancel</a>
          <button class="button-default max-percent-width" type="submit">create link</button>
        </div>
      </form>
      <div class="share-link-card max-percent-width">       
        <% if (shareLink) { %>
          <br>
          <h4 class="font-text">Your share link is...</h4>
          <input class="share-link-input" type="text" value="<%= shareUrl %>" readonly>
          <div class="button-container-row-space-evenly margin-top">
            <button id="copy-share-link-input" class="button-default max-percent-width copy-share-link-button" type="button">
              copy share link
            </button>
          </div>          
        <% } %>
      </div>
      <br>
      <div class="element-container-col-default form-width">
        <h2 class="app-subtitle">
          <% if (itemType === "folder") { %>
          Folder
          <% } else { %> 
          File
          <% } %>
          Share History
        </h2>
        <% if (itemType === "folder") { %> 
          <% if (shareHistoryByFolder.length === 0) { %>
            <div class="font-text">
              <h3>There is no history of sharing this folder.</h3>
            </div>
            <% } else { %> 
            <% shareHistoryByFolder.forEach(record => { %>
              <%- include('./partials/share-link-history.ejs', { record }) %>
            <% }) %> 
            <% } %>           
        <% } %>
        <% if (itemType === "file") { %> 
          <% if (shareHistoryByFile.length === 0) { %>
            <div class="font-text">
              <h4>There is no history of sharing this file.</h4>
            </div>
            <% } else { %> 
            <% shareHistoryByFile.forEach(record => { %>
              <%- include('./partials/share-link-history.ejs', { record }) %>
            <% }) %> 
            <% } %>     
        <% } %>
      </div>
    </main>
    <script src="/js/expiration-select-custom.js" defer></script>
    <script src="/js/copy-share-link.js" defer></script>
  </body>
</html>
