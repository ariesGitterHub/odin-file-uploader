<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-default flex-gap">
    <header class="sticky-header element-container-col-default flex-gap">
      <%- include('./partials/title.ejs') %>
    </header>
    <main class="frame-border">
      <div class="app-subtitle element-container-row-center-start">
        <h1>Share Page</h1>
      </div>
      <div class="element-container-col-start-center flex-gap">
        <h2 class="card-text-hover-selector">
          <%= shareLink.folderId ? shareLink.folder.folderName : shareLink.file.originalFileName %>
          <%= shareLink.folderId ? "(folder)" : "(file)" %>
        </h2>        
        <% if (shareLink.fileId) { %> 
          <!-- <div class="share-border"> -->
          <div class="element-container-row-center-start flex-gap flex-wrap">
            <!-- <div class="share-backdrop"><strong>type</strong> <%#= shareLink.file.mimeType %></div> -->
            <div class="share-backdrop"><strong>type</strong> <%= shareLink.mimeLabel %></div>
            <!-- <div class="share-backdrop"><strong>size</strong> <%#= shareLink.file.sizeBytes %></div> -->
            <div class="share-backdrop"><strong>size</strong> <%= shareLink.sizeLabel %></div>
            <div class="share-backdrop"><strong>download count</strong> <%= shareLink.downloadCount %></div>
            <div class="share-backdrop"><strong>download maximum</strong> <%= shareLink.maxDownloads ? shareLink.maxDownloads : "unlimited" %></div>
            <!-- <div class="share-backdrop"><strong>expires</strong> <%#= shareLink.expiresAtLabel %></div> -->
            <div class="share-backdrop"><strong>expires</strong> <%= shareLink.expiresAtLabel %></div>
            <div class="share-backdrop"><strong>share status</strong> <%= shareLink.isActive ? "enabled" : "disabled" %></div>
            <!-- <div class="share-backdrop"><strong>permission</strong> <span class="lowercase"><%#= shareLink.permission %></span></div> -->
        </div>  
        <% } %>
      </div>
    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>