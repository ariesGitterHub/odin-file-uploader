<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default flex-gap">
      <!-- <div> -->
        <!-- <h2 class="subtitle">Current root folders for <%#= user.firstName %></h2> -->
      <!-- </div> -->
       <div>

       </div>
        <div class="element-container-row-start-center flex-gap">
          <% userFolders.forEach(function(folder) { %> 
            <!-- Be safe against both null and undefined, use ==, not === because: null == undefined // true-->
          <%# if (folder.parentFolderId == null) { %> 
          
          <a class="button-default folder-card" href="/app/user-folder/<%= folder.id %>">
            <span class="emoji folder-emoji" role="img" aria-label="Data folder">
              <%= folder.emoji %>
            </span>
            <p><%= folder.folderName%></p>
            <p>(<%= folder.fileCount %> files)</p>
          </a>
          <%# } %>
          <% }) %>
      </div>
    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>
