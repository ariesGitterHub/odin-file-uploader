<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <!-- <main class="element-container-col-default flex-gap"> -->
    <main class="element-container-col-default current-folder-container flex-gap max-percent-width"> 
      <div class="element-container-col-default flex-wrap">
        <!-- <h2 class="app-subtitle">
          Root Folders        
        </h2> -->
        <p class="app-subtitle">
          <%= formatRootFoldersSize %>/<%= formatUserMaxStorage %> (<%= currentStoragePercentage %>%) used      
        </p>
      </div>
      <div class="current-root-items">
        <div class="root-section-title folder-color">
          <h3>Root Folder<%= rootFolderCount === 1 ? "" : "s" %></h3>
        </div>
        <!-- <div class="element-container-row-start-center flex-gap flex-wrap margin-left-right"> -->

        <!-- <div class="subfolder-item-section margin-left-right"> -->
        <div class="root-item-section">
          <% if (userFolders.length === 0) { %> 
            <div class="element-container-row-start-start font-text folder-color">
                <p>There are no current root folders.</p>
            </div>
          <% } else { %> 
            <% userFolders.forEach(function(folder) { %> 
                <a class="card button-default folder-card" href="/app/user-folder/<%= folder.id %>">
                  <div class="element-container-row-start-start flex-gap">
                    <span class="emoji" role="img" aria-label="Data folder">
                      <%= folder.emoji %>
                    </span>
                    <div class="element-container-col-start-center">
                      <div class="element-container-row-center-start flex-wrap">
                        <h3 class="folder-card-name font-title"><%= folder.folderName%></h3>
                      </div>
                      <% if (folder.subfolderCount > 0 || folder.fileCount > 0) { %> 
                      <div class="element-container-row-center-start flex-gap">
                        <p class="folder-card-contents font-text">
                          (<%= folder.subfolderCount %> <%= folder.subfolderCount === 1 ? "subfolder" : "subfolders" %>,
                        <%= folder.fileCount %> <%= folder.fileCount === 1 ? "file" : "files" %>)
                        </p>                     
                      </div>
                      <% } else { %> 
                      <div class="element-container-col-start-center">
                        <p class="folder-card-contents font-text">(empty folder)</p>         
                      </div>
                      <% } %> 
                    </div>
                  </div>
                </a>
              <% }) %>
            <% } %>
        </div>
      </div>



    </main>
  </body>
</html>
