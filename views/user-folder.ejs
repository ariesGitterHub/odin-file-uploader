            share folder
          </button>
          <button class="button-default w folder-button">
            <!-- <span class="emoji">🔗</span>  -->
            edit folder
          </button>
          <button class="button-default  folder-button">
            <!-- <span class="emoji">❌</span> -->
            delete folder</button>
        </div>        
      </div>

      <div class="file-container">
      <!-- Individual older views -->
