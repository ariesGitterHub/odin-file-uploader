  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default current-folder-card flex-gap">
      <div class="element-container-col-start-center width-default">
        <div class="subtitle">
          <h2> <span class="emoji">📁</span> documents (XXkb)</h2>
          <p class="font-normal"> Word docs, txt files, etc.</p>
        </div>
        <!-- <div class="folder-description">
          <p> Word docs, txt files, etc.</p>
        </div>   -->
        <div class="button-container-row-space-evenly">
