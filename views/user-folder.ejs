<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default current-folder-container flex-gap">
      <div class="element-container-col-start-center width-default current-parent-folder-container">
        <div class="element-container-col-start-center">
          <div class="element-container-row-start-start">  
            <div class="current-folder-emoji">
              <span class="emoji"><%= folder.emoji %></span>
            </div>
            <div>
              <h2 class="current-folder-name"><%= folder.folderName %></h2>
            </div>
          </div> 
          <div class="current-folder-details">
            <div class="details-backdrop">
              <% if (folder.parentFolderId === null) { %> 
                <strong>Virtual Path:</strong> /<span class="lowercase"><%= folder.folderName %></span>
              <% } else { %> 
                <strong>Virtual Path:</strong> /<span class="lowercase"><%= folder.parentFolder.folderName %>/<%= folder.folderName %></span>
              <% } %>
            </div>
            <div class="details-backdrop <%= folder.folderDescription ? '' : 'hidden' %>">
              <strong>Description:</strong> <%= folder.folderDescription %>          
            </div>
          </div>
        </div>  
      <%- include('./partials/folder-buttons.ejs') %>
      </div>
      <div class="current-folder-items">
        <div class="subfolder-section-title">
          <h3><span class="emoji"><%= folder.emoji %></span> subfolders</h3>
        </div>
        <div class="subfolder-item-section">
          <% if (childFolders.length === 0) { %> 
            <div class="font-normal folder-color">
              <h4>There are no current subfolders.</h4>
            </div>
          <% } else { %> 
          <% childFolders.forEach(childFolder => { %> 
            <a class="button-default folder-card" href="/app/user-folder/<%= childFolder.id %>">
            <span class="emoji folder-emoji" role="img" aria-label="Data folder">
              <%= childFolder.emoji %>
            </span>
            <p class="uppercase"><%= childFolder.folderName%></p>
            <div class="element-container-col-start-center folder-card-content">  
              <p class="<%= childFolder.subfolderCount === 0  ? 'hidden' : '' %>"><%= childFolder.subfolderCount %> subfolder(s)</p>
              <p class="<%= childFolder.fileCount === 0  ? 'hidden' : '' %>"><%= childFolder.fileCount %> file(s)</p>        
            </div>
          </a>
            <% }) %>
            <% } %>
        </div>
        <div class="file-section-title">
          <h3><span class="emoji"><%= folder.emoji %></span> files</h3>
        </div>
        <div class="file-item-section">
          <% if (folder.files.length === 0) { %>
          <div class="font-normal file-color">
            <h4>There are no current files.</h4>
          </div>
          <% } else { %> 
        <% folder.files.forEach(file => { %>
        <div class="card file-border">
          <h3 class="card-name file-color"><%= file.originalFileName %></h3>
          <div class="element-container-row-center-start flex-gap">
            <div class="details-backdrop"><strong>size</strong> <%= file.sizeLabel %> </div>
            <div class="details-backdrop"><strong>type</strong> <%= file.mimeType %></div>
          </div>  
          <div class="element-container-row-center-start flex-gap">
            <div class="details-backdrop"><strong>created</strong> <%= file.createdAtLabel %></div>
            <!-- TODO - check below when I am able to make updates -->
            <% if (file.createdAtLabel !== file.updatedAtLabel) { %>
            <div class="details-backdrop"><strong>updated</strong> <%= file.updatedAtLabel %></div>
            <% } %>
          </div>  
          <%#- include('./partials/file-buttons.ejs') %>
          <%- include('./partials/file-buttons.ejs', { folder, file }) %>
          </div>
          <% }) %>  
          <% } %>
        </div>
      </div>
    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>