<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default current-folder-container flex-gap">
      <div class="element-container-col-start-center current-parent-folder-section">
        <div class="element-container-col-start-center">
          <div class="element-container-row-start-start">  
            <div class="current-folder-emoji margin-bottom">
              <span class="emoji"><%= folder.emoji %></span>
            </div>
            <div>
              <h2 class="current-folder-name"><%= folder.folderName %></h2>
            </div>
          </div> 
          <div class="current-folder-details">
            <div class="details-backdrop">
              <% if (folder.parentFolderId === null) { %> 
                <strong>parent folder</strong> None
              <% } else { %> 
                <strong>parent folder</strong> <%= folder.parentFolder.folderName %>
              <% } %>
            </div>
            <div class="details-backdrop">
              <strong>folder size</strong> <%= formatFolderSize %>
            </div>
            <div class="details-backdrop">
              <strong>created</strong> <%= formatCreatedAtDate %>
            </div>
            <div class="details-backdrop <%= folder.updatedAt.getTime() !== folder.createdAt.getTime() ? '' : 'hidden' %> ">
              <strong>updated</strong> <%= formatUpdatedAtDate %>
              <!-- <strong>updated</strong> <%#= folder.updatedAt %> -->
            </div>
            <div class="details-backdrop <%= folder.folderDescription ? '' : 'hidden' %>">
              <strong>description</strong> <%= folder.folderDescription %>          
            </div>
          </div>
        </div>  
      <%- include('./partials/buttons/folder-buttons.ejs', { folder }) %>
      </div>
      <div class="current-folder-items">
        <div class="subfolder-section-title folder-color">
          <h3><span class="emoji"><%= folder.emoji %></span> subfolders</h3>
        </div>
        <div class="subfolder-item-section">
          <% if (childFolders.length === 0) { %> 
            <div class="element-container-row-start-start font-text folder-color">
              <p>There are no current subfolders.</p>
            </div>
          <% } else { %> 
          <% childFolders.forEach(childFolder => { %> 
            <a class="card button-default folder-card" href="/app/user-folder/<%= childFolder.id %>">
            <div class="element-container-row-start-start flex-gap">
              <span class="emoji" role="img" aria-label="Data folder">
                <%= childFolder.emoji %>
              </span>
              <div class="element-container-col-start-center">
                <div class="element-container-row-center-start flex-wrap">
                  <h3 class="folder-card-name font-title"><%= childFolder.folderName%></h3> 
                </div>
                <% if (childFolder.subfolderCount > 0 || childFolder.fileCount > 0) { %> 
                <div class="element-container-row-center-start flex-gap"> 
                  <p class="folder-card-contents font-text">
                    (<%= childFolder.subfolderCount %> <%= childFolder.subfolderCount === 1 ? "subfolder" : "subfolders" %>,
                    <%= childFolder.fileCount %> <%= childFolder.fileCount === 1 ? "file" : "files" %>)
                  </p>        
                </div>
                <% } else { %> 
                  <div class="element-container-col-start-center">
                    <p class="folder-card-contents font-text">(empty folder)</p>         
                  </div>
                <% } %>  
              </div>
            </div>
          </a>
          <% }) %>
          <% } %>
        </div>
        <div class="file-section-title file-color">
          <h3><span class="emoji"><%= folder.emoji %></span> files</h3>
        </div>
        <div class="file-item-section">
          <% if (folder.files.length === 0) { %>
          <div class="element-container-row-start-start font-text file-color">
            <p>There are no current files.</p>
          </div>
          <% } else { %> 
        <% folder.files.forEach(file => { %>
        <div class="card file-border">
          <h3 class="card-text-hover-selector font-title file-color"><%= file.originalFileName %></h3>
          <div class="element-container-row-center-start flex-gap flex-wrap">
            <div class="details-backdrop"><strong>size</strong> <%= file.sizeLabel %> </div>
            <!-- <div class="details-backdrop"><strong>type</strong> <%#= file.mimeType %></div> -->
          <!-- </div>   -->
          <!-- <div class="element-container-row-center-start flex-gap"> -->
            <!-- <div class="details-backdrop"><strong>size</strong> <%#= file.sizeLabel %> </div> -->
            <!-- <div class="details-backdrop"><strong>type</strong> <%#= file.mimeType %></div> -->
            <div class="details-backdrop"><strong>type</strong> <%= file.mimeLabel %></div>
          <!-- </div>   -->
          <!-- <div class="element-container-row-center-start flex-gap"> -->
            <div class="details-backdrop"><strong>created</strong> <%= file.createdAtLabel %></div>
            <!-- TODO - check below when I am able to make updates -->
            <% if (file.createdAtLabel !== file.updatedAtLabel) { %>
            <div class="details-backdrop"><strong>updated</strong> <%= file.updatedAtLabel %></div>
            <% } %>
          </div>  
          <%- include('./partials/buttons/file-buttons.ejs', { folder, file }) %>
          </div>
          <% }) %>  
          <% } %>
        </div>
      </div>
    </main>
    <%#- include('./partials/footer.ejs') %>
    <%- include("./partials/modal/deletion-modal") %>
    <script src="/js/delete-modal.js" defer></script>
  </body>
</html>