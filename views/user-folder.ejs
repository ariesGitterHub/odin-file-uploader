<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default current-folder-card flex-gap">
      <div class="element-container-col-start-center width-default current-folder-container">
        
          <!-- <div class="current-folder-emoji"><span class="emoji"><%#= folder.emoji %></span></div> -->
        <div class="element-container-col-start-center">
          <div class="element-container-row-start-start">  
            <div class="current-folder-emoji">
              <span class="emoji"><%= folder.emoji %></span>
            </div>
            <div>
              <h2 class="current-folder-name"><%= folder.folderName %></h2>
            </div>
          </div>  
            <p class="current-folder-description font-normal"><%= folder.folderDescription %></p>
        </div>  
        

        <!-- <div class="button-container-row-center-start"> -->
        <div class="button-container-row-space-evenly">
          <button class="button-default  folder-button">
            <!-- <span class="emoji">🔗</span>  -->
            share folder
          </button>
          <button class="button-default w folder-button">
            <!-- <span class="emoji">🔗</span>  -->
            edit folder
          </button>
          <button class="button-default  folder-button">
            <!-- <span class="emoji">❌</span> -->
            delete folder</button>
        </div>        
      </div>

      <div class="file-container">
        <% if (folder.files.length === 0) { %>
          <div class="current-folder-empty">
            <h3>There are no files in this folder. <span class="emoji">😐</span></h3>
          </div>
          <% } else { %> 
        <% folder.files.forEach(file => { %>
        <div class="file-card">
          <h3 class="file-name"><%= file.originalFileName %></h3>
          <div class="element-container-row-center-start flex-gap">
            <!-- <div class="file-details"><strong>size</strong> <%#= file.sizeBytes %></div> -->
            <div class="file-details"><strong>size</strong> <%= file.sizeLabel %> </div>
            <div class="file-details"><strong>type</strong> <%= file.mimeType %></div>
          </div>  
          <div class="element-container-row-center-start flex-gap">
            <!-- <div class="file-details"><strong>size</strong> <%#= file.sizeBytes %></div> -->
            <div class="file-details"><strong>created</strong> <%= file.createdAtLabel %></div>
            <!-- TODO - check below when I am able to make updates -->
            <% if (file.createdAtLabel !== file.updatedAtLabel) { %>
            <div class="file-details"><strong>updated</strong> <%= file.updatedAtLabel %></div>
            <% } %>
            

          </div>  
          <div class="button-container-row-space-evenly">
            <button class="button-default wide-button file-button">
              <!-- <span class="emoji">🔗</span>  -->
              <span>share file</span>
            </button>
            <button class="button-default wide-button file-button">
              <!-- <span class="emoji">⬇</span> -->
              <span>download file</span>
            </button>
            <button class="button-default wide-button file-button">
              <!-- <span class="emoji">❌</span> -->
              <span>delete file</span>
            </button>
          </div>
        </div>
        <% }) %>  
        <% } %>      
      </div>



      


    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>