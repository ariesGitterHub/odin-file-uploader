<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default current-folder-card flex-gap">
      <div class="element-container-col-start-center width-default current-parent-folder">
        
          <!-- <div class="current-folder-emoji"><span class="emoji"><%#= folder.emoji %></span></div> -->
        <div class="element-container-col-start-center">
          <div class="element-container-row-start-start">  
            <div class="current-folder-emoji">
              <span class="emoji"><%= folder.emoji %></span>
            </div>
            <div>
              <h2 class="current-folder-name"><%= folder.folderName %></h2>
            </div>
          </div>  
          <div class="current-folder-parent">
            <% if (folder.parentFolderId === null) { %> 
              <p>Root/<%= folder.folderName %></p>
            <% } else { %> 
              <p><%= folder.parentFolder.folderName %>/<%= folder.folderName %></p>
            <% } %>
          </div>
          <div class="current-folder-description">
            <p><%= folder.folderDescription %></p>            
          </div>
        </div>  
      <%- include('./partials/folder-buttons.ejs') %>
      </div>


      <div class="current-folder-items">
        <div class="element-container-col-start-center folder-items">
          <p><%= folder.folderName %> is the parent folder.</p>
          <%= folder.id %> is the parent folder id.</p>
          <% if (childFolders.length === 0) { %> 
            <p>Nada</p>
          <% } else { %> 
          <p>Something</p>
          <% childFolders.forEach(childFolder => { %> 
            <%#= childFolder.folderName %>
            <a class="button-default folder-card" href="/app/user-folder/<%= childFolder.id %>">
            <span class="emoji folder-emoji" role="img" aria-label="Data folder">
              <%= childFolder.emoji %>
            </span>
            <p><%= childFolder.folderName%></p>
            <p>(<%= childFolder.fileCount %> files)</p>
          </a>
            <% }) %>
            <% } %>
        </div>
        <div class="file-items">
          <% if (folder.files.length === 0) { %>
          <div class="current-folder-empty">
            <h3>There are no files in this folder. <span class="emoji">😐</span></h3>
          </div>
          <% } else { %> 
        <% folder.files.forEach(file => { %>
        <div class="file-card">
          <h3 class="file-name"><%= file.originalFileName %></h3>
          <div class="element-container-row-center-start flex-gap">
            <!-- <div class="file-details"><strong>size</strong> <%#= file.sizeBytes %></div> -->
            <div class="file-details"><strong>size</strong> <%= file.sizeLabel %> </div>
            <div class="file-details"><strong>type</strong> <%= file.mimeType %></div>
          </div>  
          <div class="element-container-row-center-start flex-gap">
            <!-- <div class="file-details"><strong>size</strong> <%#= file.sizeBytes %></div> -->
            <div class="file-details"><strong>created</strong> <%= file.createdAtLabel %></div>
            <!-- TODO - check below when I am able to make updates -->
            <% if (file.createdAtLabel !== file.updatedAtLabel) { %>
            <div class="file-details"><strong>updated</strong> <%= file.updatedAtLabel %></div>
            <% } %>
          </div>  
        <%- include('./partials/file-buttons.ejs') %>
        </div>
        <% }) %>  
        <% } %>
        </div>
              
      </div>



      


    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>