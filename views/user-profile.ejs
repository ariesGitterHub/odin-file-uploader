<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body class="element-container-col-center-start flex-gap">
    <%- include('./partials/header.ejs') %>
    <main class="element-container-col-default frame-border-white">
        <h2 class="subtitle">Change Your Profile</h2>
       <form class="element-container-col-start-center form-width" action="/app/user-profile" method="POST">
        <%# CSRF Token - hidden input for forms %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="first-name-user-profile">first name</label>
        <input
          id="first-name-user-profile"
          type="text"          
          name="first_name"
          value="<%= formData?.first_name || '' %>"
        />
        <label for="last-name-user-profile">last name</label>
        <input
          id="last-name-user-profile"
          type="text"          
          name="last_name"
          value="<%= formData?.last_name || '' %>"
        />
        <div class="element-container-row-start-center">
          <label for="email-user-profile">email</label>
          <% if (errors && errors.some(e => e.field === 'email')) { %>
            <% errors.filter(e => e.field === 'email').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
        </div>
        <input
          id="email-user-profile"
          type="email"            
          name="email"
          value="<%= formData?.email || '' %>"
        />

        <div class="element-container-row-start-center">
          <label for="password-user-profile">password</label>
          <% if (errors && errors.some(e => e.field === 'password')) { %>
            <% errors.filter(e => e.field === 'password').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
        </div>
        <input
          id="password-user-profile"
          type="password"
          name="password"
          placeholder="leave blank to keep existing password"
        />
        <div class="element-container-row-start-center">
          <label for="confirm-password-user-profile">confirm password</label> 
          <% if (errors && errors.some(e => e.field === 'confirm_password')) { %>
            <% errors.filter(e => e.field === 'confirm_password').forEach(e => { %>
              <span class="error-message">[<%= e.message %>]</span>
            <% }) %>
          <% } %>
        </div>
        <input
          id="confirm-password-user-profile"
          type="password"
          name="confirm_password"
          placeholder="re-enter, if new password"
        />

        <%- include("./partials/password-rules.ejs") %>

        <div class="button-container-row-space-evenly margin-top">
          <a class="button-default" href="/app/user-data">cancel</a>
          <button class="button-default" type="submit">update</button>
        </div>
      </form>
    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>
